  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Stereopsis.BeatSequence
  beats:
  - message: Heavier than the others, and silent. Wax sealed under the cap.
    lockedMessage: 
    requiresItemId: 
    requiresFlag: 
    taps: 1
    moveDelta: {x: 0, y: 0, z: 0}
    rotateDelta: {x: 0, y: 0, z: 0}
    reveals: []
    setsFlag: 
  - message: The wax is off.
    lockedMessage: The wax flakes under your thumbnail.
    requiresItemId: 
    requiresFlag: 
    taps: 2
    moveDelta: {x: 0, y: 0, z: 0}
    rotateDelta: {x: 0, y: 0, z: 0}
    reveals: []
    setsFlag: 
  - message: Two full turns, stiff then free, and the cap is off.
    lockedMessage: The cap fights the whole turn.
    requiresItemId: 
    requiresFlag: 
    taps: 2
    moveDelta: {x: 0, y: 0, z: 0}
    rotateDelta: {x: 0, y: 60, z: 0}
    reveals: []
    setsFlag: 
  - message: A plug of cotton wool - pull. A small brass key slides into your palm.
    lockedMessage: 
    requiresItemId: 
    requiresFlag: 
    taps: 1
    moveDelta: {x: 0, y: 0.06, z: 0}
    rotateDelta: {x: 0, y: 0, z: 0}
    reveals:
    - {fileID: 1438428292}
    setsFlag: 
  animated: {fileID: 0}
  secondsPerBeat: 0.45
