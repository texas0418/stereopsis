  m_Script: {fileID: 11500000, guid: 871a59ef81fc4408f9f098fcacfc07ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Stereopsis.Readable
  title: A coat on the peg by the door
  body: 'Too fine for a servant, too plain for Vane. Salt-stained at the hem.


    Inside
    the collar, a maker''s mark - the same mark stamped into the cut purse strap.


    Caleb
    Merrick walked in here and hung his coat up, expecting to leave.


    [placeholder]'
  setsFlag: 
