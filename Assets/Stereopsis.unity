  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 871a59ef81fc4408f9f098fcacfc07ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Stereopsis.Readable
  title: Execution broadside, spring 1699
  body: 'A true and faithful ACCOUNT of the EXECUTION of


    JONAS REED


    servant,
    aged twenty-two years, for the murther of the shipmaster CALEB MERRICK, with
    a relation of his wicked life and impenitent end.


    The first time anyone
    has said his name to you.


    It was being used to stop a lid rattling.


    [placeholder]'
  setsFlag: knows-name
