  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Stereopsis.BeatSequence
  beats:
  - message: It rocks under the tap. It will not lift by hand.
    lockedMessage: 
    requiresItemId: 
    requiresFlag: 
    taps: 1
    moveDelta: {x: 0, y: 0, z: 0}
    rotateDelta: {x: 0, y: 0, z: 0}
    reveals: []
    setsFlag: 
  - message: The bar seats into the gap with a click.
    lockedMessage: One end sits proud. It wants levering.
    requiresItemId: pry-bar
    requiresFlag: 
    taps: 1
    moveDelta: {x: 0, y: 0, z: 0}
    rotateDelta: {x: 0, y: 0, z: 0}
    reveals: []
    setsFlag: 
  - message: The board pivots up with a crack. A shallow void beneath.
    lockedMessage: 
    requiresItemId: pry-bar
    requiresFlag: 
    taps: 1
    moveDelta: {x: 0.3, y: 0.08, z: 0}
    rotateDelta: {x: 0, y: 0, z: 20}
