  m_Script: {fileID: 11500000, guid: 871a59ef81fc4408f9f098fcacfc07ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Stereopsis.Readable
  title: A magistrate's docket, 1774
  body: 'A case heard the same week the plaster was wet. Decided in one sitting,
    decided fast, and - on the evidence bound with it - decided wrong.


    Nothing
    to do with Jonas Reed. It is here to show what nineteen years of judgments were
    worth to the man protecting them.


    [placeholder]'
  setsFlag: 
