  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 871a59ef81fc4408f9f098fcacfc07ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Stereopsis.Readable
  title: JONAS REED
  body: 'Written in the dust of the present, in letters a hand high, three hundred
    and twenty-seven years late.


    Now raise the stereoscope. Seat each card
    in turn and look at this wall.


    1922: blank. 1861: blank. 1774: blank. 1698:
    blank.


    You are the first thing that ever happened in this room that leaves
    no mark going backward - and the only one that leaves a mark going forward.


    Say
    it somewhere. That was all she asked.


    [the ending, grey-box form]'
  setsFlag: name-written
