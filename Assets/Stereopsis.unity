  m_Script: {fileID: 11500000, guid: 1deac442a6a58433dace230d31df1a33, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Stereopsis.BeatSequence
  beats:
  - message: The lid seam is a ring of rust. It will not move by thumb.
    lockedMessage: 
    requiresItemId: 
    requiresFlag: 
    taps: 1
    moveDelta: {x: 0, y: 0, z: 0}
    rotateDelta: {x: 0, y: 0, z: 0}
    reveals: []
    setsFlag: 
  - message: The bar tip seats into the seam.
    lockedMessage: Rusted shut. You need something to twist against.
    requiresItemId: pry-bar
    requiresFlag: 
    taps: 1
    moveDelta: {x: 0, y: 0, z: 0}
    rotateDelta: {x: 0, y: 0, z: 0}
    reveals: []
    setsFlag: 
  - message: Twist - it jams. Twist back the other way - the lid grinds off. Wax
      paper inside.
    lockedMessage: 
    requiresItemId: pry-bar
    requiresFlag: 
    taps: 1
    moveDelta: {x: 0, y: 0.05, z: 0.06}
    rotateDelta: {x: 0, y: 30, z: 0}
    reveals:
    - {fileID: 1007595030}
    setsFlag: 
  animated: {fileID: 0}
  secondsPerBeat: 0.45
