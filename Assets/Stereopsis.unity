  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 871a59ef81fc4408f9f098fcacfc07ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Stereopsis.Readable
  title: Under the hearthstone
  body: 'The mortar is still soft. The slab comes up.


    Everything else in this
    room is evidence. This is not evidence.


    This is Caleb Merrick, and he has
    been fifteen feet from a dying woman who spent seven weeks working out what happened
    to him, and she never once looked down.


    [placeholder - the finale beat]'
  setsFlag: found-merrick
